{
  "name": "Custom Python Env",

  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "bash -lc 'pip install --upgrade pip && pip install -r ../requirements.txt'"
}

